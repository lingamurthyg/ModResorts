# Dockerfile ignore patterns for Java Maven project
# Build outputs
target/
build/
*.war
*.jar
*.ear

# Maven wrapper files (use system maven instead)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (use system gradle instead)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
*.iws
*.ipr
.DS_Store

# Version control
.git/
.gitignore
.gitattributes

# Documentation
*.md
README*
LICENSE*
CHANGELOG*

# Test files
src/test/
**/test/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
Thumbs.db
.DS_Store

# Docker files
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile
azure-pipelines.yml

# Kubernetes
kubernetes/
k8s/
*.yaml
*.yml
